# Copy to .env.local. Set these to the API's configured host port if it differs.
CLIPPER_API_SERVER_URL=http://localhost:8001

# Used by the browser for all API calls through the Next.js proxy
NEXT_PUBLIC_API_BASE_URL=/backend-api

# Used by the browser for video file uploads — goes DIRECTLY to the API,
# bypassing the Next.js proxy body-size limit. Must be reachable from the browser.
NEXT_PUBLIC_UPLOAD_API_BASE_URL=http://localhost:8001
