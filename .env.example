# Local-development values only. Replace credentials before exposing services.
HOST_BIND_ADDRESS=127.0.0.1

POSTGRES_DB=clipper
POSTGRES_USER=clipper
POSTGRES_PASSWORD=clipper-dev-password
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=clipper
MINIO_ROOT_PASSWORD=clipper-dev-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8001
CLIPPER_WHISPER_MODEL=small
CLIPPER_WORKER_REPLICAS=1

CLIPPER_PROJECT_NAME=Local AI Video Clipper API
CLIPPER_DATABASE_URL=postgresql+psycopg://clipper:clipper-dev-password@localhost:5432/clipper
CLIPPER_REDIS_URL=redis://localhost:6379/0
CLIPPER_HF_TOKEN=
CLIPPER_LLM_PROVIDER=ollama
CLIPPER_LLM_MODEL=llama3.2
CLIPPER_OLLAMA_BASE_URL=http://ollama:11434
CLIPPER_LLM_API_BASE_URL=https://api.openai.com/v1
CLIPPER_LLM_API_KEY=
CLIPPER_OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
CLIPPER_OBJECT_STORAGE_ACCESS_KEY=clipper
CLIPPER_OBJECT_STORAGE_SECRET_KEY=clipper-dev-password
CLIPPER_OBJECT_STORAGE_BUCKET=videos

# --- Platform publishing (optional) ---
# Generate an encryption key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLIPPER_TOKEN_ENCRYPTION_KEY=
# Public URL the OAuth callback redirects to (must match your registered redirect URI)
CLIPPER_PUBLIC_API_URL=http://localhost:8001

# YouTube: https://console.cloud.google.com → APIs & Services → Credentials
# Redirect URI to register: http://localhost:8001/auth/youtube/callback
CLIPPER_YOUTUBE_CLIENT_ID=
CLIPPER_YOUTUBE_CLIENT_SECRET=

# TikTok: https://developers.tiktok.com → Manage Apps
# Redirect URI to register: http://localhost:8001/auth/tiktok/callback
CLIPPER_TIKTOK_CLIENT_ID=
CLIPPER_TIKTOK_CLIENT_SECRET=

# Instagram/Meta: https://developers.facebook.com → My Apps
# Redirect URI to register: http://localhost:8001/auth/instagram/callback
CLIPPER_INSTAGRAM_CLIENT_ID=
CLIPPER_INSTAGRAM_CLIENT_SECRET=

# Set to 1 when running with docker-compose.gpu.yml for NVENC hardware encoding
CLIPPER_GPU=0

# --- Railway deployment ---
# See docs/RAILWAY.md for full Railway setup guide.
# On Railway, use NVIDIA NIM for LLM (faster, no local Ollama needed):
# CLIPPER_LLM_PROVIDER=openai-compatible
# CLIPPER_LLM_API_BASE_URL=https://integrate.api.nvidia.com/v1
# CLIPPER_LLM_API_KEY=nvapi-...
# CLIPPER_LLM_MODEL=meta/llama-3.1-8b-instruct
# CLIPPER_WHISPER_MODEL=base
